[Unit]
Description=Grace BJJ demo preview API (separate database, not production)
After=network.target

[Service]
Type=simple
User=bjj-demo
Group=bjj-demo
WorkingDirectory=/srv/bjj-planner-demo
Environment=BJJ_DATA_DIR=/var/lib/bjj-planner/demo-data
Environment=BJJ_DB=/var/lib/bjj-planner/demo.db
Environment=BJJ_COOKIE_SECURE=1
Environment=BJJ_TRUST_PROXY=1
Environment=BJJ_HOST=127.0.0.1
Environment=BJJ_PORT=8767
Environment=BJJ_COOKIE_NAME=bjj_demo_session
Environment=BJJ_COOKIE_PATH=/demo
Environment=BJJ_WAIVER_SUBMISSIONS=1
Environment=BJJ_WAITLIST=1
Environment=BJJ_SQLITE_JOURNAL=MEMORY
ExecStart=/usr/bin/python3 -m server serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/bjj-planner-demo
ReadWritePaths=/var/lib/bjj-planner/demo.db /var/lib/bjj-planner/demo-data
InaccessiblePaths=/var/lib/bjj-planner/data.db /srv/bjj-planner

[Install]
WantedBy=multi-user.target
